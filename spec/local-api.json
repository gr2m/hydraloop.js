    "schemas": {
      "WaterRecycledCoordinates": {
        "type": "object",
        "properties": {
          "x": {
            "type": "string",
            "description": "Timestamp"
          },
          "y": {
            "type": "number",
            "description": "Water recycled in liters"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "WaterIntakeOfHouseCoordinates": {
        "type": "object",
        "properties": {
          "x": {
            "type": "string",
            "description": "Timestamp"
          },
          "y": {
            "type": "number",
            "description": "Water intake of house in liters"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "WaterRecycledRecords": {
        "type": "object",
        "properties": {
          "waterRecycled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaterRecycledCoordinates"
            }
          },
          "waterIntakeOfHouse": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaterIntakeOfHouseCoordinates"
            }
          }
        },
        "required": [
          "waterRecycled",
          "waterIntakeOfHouse"
        ]
      },
      "AuxiliaryOutput": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "liters": {
            "type": "number"
          }
        },
        "required": [
          "start",
          "end",
          "liters"
        ]
      },
      "IoCoordinates": {
        "type": "object",
        "properties": {
          "x": {
            "type": "string",
            "description": "Timestamp"
          },
          "y": {
            "type": "number"
          },
          "actorId": {
            "type": "string"
          }
        },
        "required": [
          "x",
          "y",
          "actorId"
        ]
      },
      "ChangeBypassModeCommand": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "activate": {
            "type": "boolean"
          }
        },
        "required": [
          "deviceId",
          "activate"
        ]
      },
      "BypassMode": {
        "type": "object",
        "properties": {
          "bypassActive": {
            "type": "boolean"
          },
          "minutesRemaining": {
            "type": "number"
          },
          "remaining": {
            "type": "string"
          }
        },
        "required": [
          "bypassActive",
          "minutesRemaining",
          "remaining"
        ]
      }
    }
