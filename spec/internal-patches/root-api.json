                    "$ref": "#/components/schemas/ListOption"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ecus/connection-data": {
      "get": {
        "responses": {
          "200": {
            "description": "Connection data of the ECU, e.g. \"1:node001-nl.hydraloop.com:443|1:hdm.hydraloop.com:443\"",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/ticket/history": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketHistoryEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/statuses": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ListOption"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object",
                            "properties": {
                              "closed": {
                                "type": "boolean"
                              }
                            },
                            "required": ["closed"]
                          }
                        },
                        "required": ["data"]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/priorities": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListOption"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/subject-types": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListOption"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/causes": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ListOption"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object",
                            "properties": {
                              "description": {
                                "type": "string"
                              }
                            },
                            "required": ["description"]
                          }
                        },
                        "required": ["data"]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/solutions": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ListOption"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object",
                            "properties": {
                              "contextInformationRequired": {
                                "type": "boolean"
                              }
                            },
                            "required": ["contextInformationRequired"]
                          }
                        },
                        "required": ["data"]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/creators": {
      "get": {
        "responses": {
