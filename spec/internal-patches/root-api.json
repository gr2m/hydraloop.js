                    "$ref": "#/components/schemas/ListOption"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/notification-entities": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      }
                    },
                    "required": ["name", "email"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device-part/io-spare-parts": {
      "get": {
        "responses": {
          "200": {
