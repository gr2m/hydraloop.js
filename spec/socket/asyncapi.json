      },
      "notificationsList": {
        "name": "notifications:list",
        "title": "notifications:list",
        "summary": "The current notifications, sent after registering",
        "payload": {
          "$ref": "#/components/schemas/NotificationList"
        },
        "x-observed": false
      },
      "timeLogUpdate": {
        "name": "time-log:update",
        "title": "time-log:update",
        "summary": "A time log started or ended",
        "payload": {
