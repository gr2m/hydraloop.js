{
  "asyncapi": "3.1.0",
  "info": {
    "title": "HDM Socket API",
    "version": "9.0.1",
    "description": "Real-time messages of the Hydraloop Device Manager (HDM), served by socket.io (Engine.IO v4, Socket.IO v5). Not documented by Hydraloop: written from the HDM web app's JavaScript and from listening with an owner account to an H600 (firmware 9.24.4).\n\nConnecting:\n\n1. Connect to one of the servers below with the token as socket.io auth: `{ token }`.\n2. The server emits `loggedIn`.\n3. Emit `register` with `[{ type: <room> }]` for each room (see the `register` channel).\n4. The server emits the event `message` with two arguments: the message name (e.g. `graph:io`) and its payload. The channels below are the rooms, and their messages are named `<room>:<event>`.\n\nRooms the account has no permission for are accepted, but send nothing. Messages with `x-observed: false` were not seen with an owner account, their payloads are taken from how the HDM web app uses them.\n\nThe connection is not closed when the token expires. A reconnect needs a new token."
  },
  "defaultContentType": "application/json",
  "servers": {
    "device": {
      "host": "hdm.hydraloop.com",
      "pathname": "/api-local/socket.io",
      "protocol": "wss",
      "title": "Device socket",
      "description": "One connection per device. The host and path follow from the device's `localApiUrl` (here `https://hdm.hydraloop.com/api-local`): its host, and its path plus `/socket.io`. Authenticates with the device token from `POST /api-root/auth/token-for-device`.",
      "security": [
        {
          "$ref": "#/components/securitySchemes/deviceToken"
        }
      ]
    },
    "notifications": {
      "host": "hdm.hydraloop.com",
      "pathname": "/api-root/person-notifications-socket.io",
      "protocol": "wss",
      "title": "Notifications socket",
      "description": "Notifications for the owner of a device. Authenticates with the device token.",
      "security": [
        {
          "$ref": "#/components/securitySchemes/deviceToken"
        }
      ]
    },
    "person": {
      "host": "hdm.hydraloop.com",
      "pathname": "/api-root/root-socket.io",
      "protocol": "wss",
      "title": "Person socket",
      "description": "Messages for the logged in person, e.g. time logs. Authenticates with the user token.",
      "security": [
        {
          "$ref": "#/components/securitySchemes/userToken"
        }
      ]
    }
  },
