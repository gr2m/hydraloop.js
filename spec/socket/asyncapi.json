        }
      }
    },
    "schemas": {
      "GraphPoint": {
        "type": "object",
        "description": "A value of a graph line at a time, as in `GET /graph/data`",
        "properties": {
          "x": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "y": {
            "type": "number",
            "description": "Raw value, see `GraphMessage` for the units"
          }
        },
        "required": ["x", "y"]
      },
      "TankPoint": {
        "type": "object",
        "description": "A tank level in pressure points (`y`), plus HDM's conversion to liters for each device version. `liters_<version>` is the level, `minLiters_<version>` and `maxLiters_<version>` the range of the calibration table. Sent for T2 (`V1_5`, `V2_0`) and T3 (`H300_V1_5`, `H300_V2_0`, `H600_V2_0`, `Concealed_V2_0`), not for T1.",
        "properties": {
          "x": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "y": {
            "type": "number",
            "description": "Pressure points"
          }
        },
        "required": ["x", "y"],
        "additionalProperties": {
          "type": "number"
        }
      },
      "RestartPoint": {
        "type": "object",
        "description": "A restart of the device controller",
        "properties": {
          "x": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "y": {
            "type": "number",
            "description": "Always 1"
          },
          "restartReasonChip": {
            "type": "number",
            "description": "Hardware reset reason of the chip, e.g. 12 (software reset of the CPU). Texts: `graph.restartReasons.chip.<n>` of the HDM web app's translations"
          },
          "restartReasonSoftware": {
            "type": "number",
            "description": "Reason of the firmware, e.g. 1 (scheduled restart) or 3 (power removed and restored). Texts: `graph.restartReasons.software.<n>`"
          }
        },
        "required": ["x", "y"]
      },
      "GraphMessage": {
        "type": "object",
        "description": "The latest value of each graph line, about every 3 seconds. The lines are those of `GET /graph/config`; lines without a new value are empty. Units of `y`: tank levels in pressure points, `power_voltage` × 0.1 V, `battery_voltage` × 0.01 V, `dist_pump_amperage`, `device_amperage`, `toilet_bar` and `wash_bar` × 0.001, `uv_temperature` in °C.",
        "properties": {
          "tank1": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TankPoint"
            }
          },
          "tank2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TankPoint"
            }
          },
          "tank1_b": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TankPoint"
            }
          },
          "tank2_b": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TankPoint"
            }
          },
          "tank3": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TankPoint"
            }
          },
          "uv_voltage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "dist_pump_amperage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "device_amperage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "toilet_bar": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "wash_bar": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "power_voltage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "battery_voltage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "uv_temperature": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "uv_intensity": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "leak_sensor": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "tank2_leveled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "tank2_b_leveled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "wifi_rssi": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "power_wattage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "restart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestartPoint"
            }
          },
          "online": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          },
          "firmware_update": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphPoint"
            }
          }
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/GraphPoint"
          }
        }
      },
      "IoPoint": {
        "type": "object",
        "properties": {
          "x": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "y": {
            "type": "number",
            "description": "Value, e.g. 1 for on and 0 for off"
          }
        },
        "required": ["x", "y"]
      },
      "IoBehavior": {
        "type": "object",
        "description": "A firmware behavior, as in `GET /graph/io`",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "typeId": {
            "type": "number"
          },
          "typeName": {
            "type": "string",
            "description": "e.g. `bypassByAppBypassValve` or `pressingOptButton` (typeId 54, engaged and disengaged around a restart)"
          },
          "subTypeId": {
            "type": "number",
            "description": "1: engaged, 2: disengaged"
          },
          "subTypeName": {
            "type": "string",
            "description": "`engaged` or `disengaged`"
          }
        },
        "required": ["time", "typeId", "typeName", "subTypeId", "subTypeName"]
      },
      "IoMessage": {
        "type": "object",
        "description": "A change of valves, pumps or sensors, as in `GET /graph/io`. Every IO is listed, only the changed ones have points.",
        "properties": {
          "lastGroupItems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "object",
            "description": "New values by IO name",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/IoPoint"
              }
            }
          },
          "manual": {
            "type": "object",
            "description": "1 while the IO is switched manually instead of by the firmware",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/IoPoint"
              }
            }
          },
          "stuckPower": {
            "type": "object",
            "description": "1 while the IO is stuck powered",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/IoPoint"
              }
            }
          },
          "behavior": {
            "type": "array",
            "description": "Behaviors that engaged or disengaged, e.g. `pressingOptButton` around a restart. Empty in most messages, also while `bypassByAppBypassValve` engaged",
            "items": {
              "$ref": "#/components/schemas/IoBehavior"
            }
          }
        },
        "required": [
          "lastGroupItems",
          "value",
          "manual",
          "stuckPower",
          "behavior"
        ]
      },
      "Routine": {
        "type": "object",
        "description": "A routine or sub-state change of a train, as in `GET /graph/routines`",
        "properties": {
          "x": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "routine": {
            "type": "number",
            "description": "Routine number, e.g. 1 for `STANDBY`"
          },
          "name": {
            "type": "string",
            "description": "e.g. `STANDBY`, `INCOMING_WATER`, `SKIM_LEVEL_DETERMINATION`, `FILTH_REMOVAL`, `TRANSFER`"
          },
          "state": {
            "type": "string",
            "description": "Sub-state, e.g. `ENTRY`, `PRESSURE_RESET`, `PASSIVE_CIRCULATE`"
          },
          "side": {
            "type": "string",
            "description": "`A`, `B` or `SYSTEM`"
          },
          "origin": {
            "type": "number"
          }
        },
        "required": ["x", "routine", "name", "state", "side", "origin"]
      },
      "RoutineMessage": {
        "type": "object",
        "properties": {
          "routines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Routine"
            }
          }
        },
        "required": ["routines"]
      },
      "SettingValue": {
        "type": "object",
        "description": "A setting the device reported, as in `GET /settings/last`. E.g. `cleaningTimeLeftA`/`B` (group 3, milliseconds of filth removal left, 16200000 when the train starts `SKIM_LEVEL_DETERMINATION`, then the time left again when `FILTH_REMOVAL` starts, e.g. 16198974, and 0 when it returns to `STANDBY`), `incomingWaterCount` (group 100, id 10), `uvCirculationTime` (group 9) or `prioritySettings` (group 100, id 53).",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "group": {
            "type": "number"
          },
          "id": {
            "type": "number"
          },
          "value": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["time", "group", "id", "value", "name"]
      },
      "StatusLogEntry": {
        "type": "object",
        "description": "An entry of the status log, as in `GET /graph/status-log`: a step of a maintenance procedure, or a device signal such as `deviceSignals.soapBomb.description`",
        "properties": {
          "fsmInstanceId": {
            "type": ["string", "null"]
          },
          "fsmParentInstanceId": {
            "type": ["string", "null"]
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "errorId": {
            "type": ["number", "null"]
          },
          "information": {
            "type": "string",
            "description": "A text, or a translation key such as `deviceSignals.soapBomb.description` or `deviceSignals.soapBomb.fixed`"
          },
          "verbose": {
            "type": "boolean"
          },
          "loginUserId": {
            "type": ["string", "null"]
          },
          "side": {
            "type": ["string", "null"],
            "description": "The train of a device signal, `A` or `B`, else empty or null"
          }
        },
        "required": ["time", "information"]
      },
      "FsmTransition": {
        "type": "object",
        "description": "A step of a finite state machine of the device, e.g. a maintenance procedure or the factory test",
        "properties": {
          "fsm": {
            "type": "string",
            "description": "Name of the state machine, e.g. `factory_test` or `change_location`"
          },
          "state": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "description": "The state, e.g. `stepAborted`"
              },
              "done": {
                "type": "boolean"
              },
              "context": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "required": ["fsm", "state"]
      },
      "DeviceProgress": {
        "type": "object",
        "description": "Progress of a firmware upload, as in the local API's `DeviceProgress` schema",
        "properties": {
          "streamIdentifier": {
            "type": ["string", "null"]
          },
          "deviceId": {
            "type": "string"
          },
          "percentage": {
            "type": "number",
            "description": "-1 when no upload is in progress"
          },
          "type": {
            "type": "string",
            "description": "e.g. `Firmware upload`"
          },
          "info": {
            "type": "string",
            "description": "e.g. ` / ` when no upload is in progress"
          },
          "created": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "updated": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          }
        },
        "required": [
          "streamIdentifier",
          "deviceId",
          "percentage",
          "type",
          "info",
          "created",
          "updated"
        ]
      },
      "LoggingEntry": {
        "type": "object",
        "description": "A line of the device log, as in `GET /logging/log`",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "deviceId": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        },
        "required": ["time", "deviceId", "line", "level"]
      },
      "DynamicGraphLine": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "measurement_kind": {
            "type": "string"
          },
          "max_decimal_places": {
            "type": "number"
          },
          "graph_min": {
            "type": "number"
          },
          "graph_max": {
            "type": "number"
          }
        },
        "required": ["name"],
        "additionalProperties": true
      },
      "DynamicGraphMessage": {
        "type": "object",
        "description": "Values of dynamic graph lines, as in `GET /graph/dynamic-data`",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DynamicGraphLine"
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GraphPoint"
              }
            }
          }
        },
        "required": ["lines", "data"]
      },
      "DeviceTask": {
        "type": "object",
        "description": "What a train does, in the terms of the device dashboard",
        "properties": {
          "side": {
            "type": "string",
            "description": "`A` or `B`"
          },
          "name": {
            "type": "string",
            "description": "e.g. `standby`, `recyclingWater`, `transfer`, `selfCleaning`, `buildingBioReactor`, `underService`"
          },
          "routine": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "TimeLeftRecycling": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "description": "`A` or `B`"
          },
          "timeRemaining": {
            "type": "number",
            "description": "Minutes of cleaning left"
          }
        },
        "required": ["side", "timeRemaining"]
      },
      "RecycleStatistics": {
        "type": "object",
        "properties": {
          "totalWaterRecycled": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "Liters"
              }
            }
          },
          "recycledYesterday": {
            "type": "number",
            "description": "Liters"
          }
        },
        "additionalProperties": true
      },
      "Notification": {
        "type": "object",
        "description": "A notification of the device for its owner",
        "properties": {
          "type": {
            "type": "string",
            "description": "e.g. `device-major`, `device-minor` or `device-notice`"
          },
          "notification": {
            "type": "string",
            "description": "Translation key, e.g. `deviceSignals.bigLeakingToilet`, with `.title` and `.description` texts"
          },
          "data": {
            "type": "object",
            "description": "Values for the placeholders of the texts",
            "additionalProperties": true
          }
        },
        "required": ["type", "notification"],
        "additionalProperties": true
      },
      "NotificationList": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          }
        },
        "required": ["records"]
      },
      "TimeLog": {
        "type": "object",
        "description": "A time log of a Hydraloop employee working on a device. Ended when `endTime` is set.",
        "properties": {
          "deviceId": {
            "type": ["string", "null"]
          },
          "serialAlias": {
            "type": "string"
          },
          "endTime": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      },
      "CallParticipant": {
        "type": "object",
        "description": "The person, as emitted by the HDM web app: `{ id, name }` with the id and name of its user",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id"],
        "additionalProperties": true
      },
      "Empty": {
        "description": "No payload is known. The HDM web app ignores it."
      },
      "RegisterPayload": {
        "type": "array",
        "description": "Subscribes to a room",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "The room, e.g. `graph`"
            }
          },
          "required": ["type"]
        },
        "minItems": 1,
        "maxItems": 1
      },
      "TimeLeftRecyclingList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TimeLeftRecycling"
        }
      },
      "DeviceTaskList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DeviceTask"
        }
      },
      "EmptyObject": {
        "type": "object",
        "description": "Always an empty object",
        "properties": {},
        "additionalProperties": false
      },
      "CallRefresh": {
        "type": "object",
        "description": "Who asked for the call participants to be sent again",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the person, e.g. a user with the HDM web app open"
          }
        },
        "required": ["name"]
      }
    }
  }
}
