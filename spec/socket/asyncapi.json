  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "httpApiKey",
        "name": "token",
        "in": "query",
        "description": "The device token from `POST /api-root/auth/token-for-device`, sent as `token` in the socket.io auth payload of the CONNECT packet, not as a query parameter."
      },
      "userToken": {
        "type": "httpApiKey",
        "name": "token",
        "in": "query",
        "description": "The user token from `POST /api-root/auth/login`, sent as `token` in the socket.io auth payload of the CONNECT packet, not as a query parameter."
      }
    },
    "messages": {
      "graphGraph": {
        "name": "graph:graph",
        "title": "graph:graph",
        "summary": "The latest value of each graph line, about every 3 seconds while the live graph is active",
        "payload": {
          "$ref": "#/components/schemas/GraphMessage"
        },
        "x-observed": true,
        "description": "Sent while someone keeps the live graph active with `local.graph.setActiveHeartBeat()` (`POST /graph/active-heart-beat`), which the HDM web app calls every 90 seconds while its graph auto-refreshes. Without it, no `graph:graph` messages arrive."
      },
      "graphIo": {
        "name": "graph:io",
        "title": "graph:io",
        "summary": "A valve, pump or sensor changed, within about 0.1 seconds",
        "payload": {
          "$ref": "#/components/schemas/IoMessage"
        },
        "x-observed": true
      },
      "graphRoutine": {
        "name": "graph:routine",
        "title": "graph:routine",
        "summary": "A routine or sub-state of a train changed",
        "payload": {
          "$ref": "#/components/schemas/RoutineMessage"
        },
        "x-observed": true
      },
      "graphRestart": {
        "name": "graph:restart",
        "title": "graph:restart",
        "summary": "The device controller restarted",
        "payload": {
          "$ref": "#/components/schemas/RestartPoint"
        },
        "x-observed": true
