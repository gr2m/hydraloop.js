{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "packages/*/index.js",
    "packages/*/index.d.ts",
    "packages/*/lib/**/*.js",
    "examples/**/*.js",
    "scripts/release-set-workspace-dependencies.js"
  ],
  "exclude": ["examples/app"]
}
